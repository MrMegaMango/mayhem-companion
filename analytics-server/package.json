{
  "name": "mayhem-companion-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "migrate:local": "wrangler d1 migrations apply mayhem-usage --local",
    "migrate:remote": "wrangler d1 migrations apply mayhem-usage --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.154.0" }
}
