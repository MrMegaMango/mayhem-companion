{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mayhem-usage",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mayhem-usage",
    // Project database identifier (not a credential). Forks must use their own D1 DB.
    "database_id": "48033037-88e1-4d98-b8c0-373ec60d1df8",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "REGISTER_LIMITER", "namespace_id": "51001", "simple": { "limit": 10, "period": 60 } },
    { "name": "REQUEST_LIMITER", "namespace_id": "51002", "simple": { "limit": 120, "period": 60 } },
    { "name": "INSTALLATION_LIMITER", "namespace_id": "51003", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["17 * * * *"] }
}
